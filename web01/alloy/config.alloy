local.file_match "nginx" {
  path_targets = [{"__path__" = "/var/log/nginx/*.log", "job" = "nginx", "host" = "web01"}]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.write.mon01.receiver]
}

loki.write "mon01" {
  endpoint {
    url = "http://192.168.56.24:3100/loki/api/v1/push"
  }
}
